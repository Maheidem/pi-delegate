{
	"name": "@maheidem/pi-delegate",
	"version": "0.2.0",
	"type": "module",
	"description": "Foreground isolated delegation and strict coordinator mode for the Pi coding agent.",
	"license": "MIT",
	"author": "maheidem",
	"keywords": [
		"pi",
		"pi-coding-agent",
		"pi-extension",
		"delegate",
		"subagent",
		"orchestration",
		"coordinator"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Maheidem/pi-delegate.git"
	},
	"bugs": {
		"url": "https://github.com/Maheidem/pi-delegate/issues"
	},
	"homepage": "https://github.com/Maheidem/pi-delegate#readme",
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"index.ts",
		"application.ts",
		"commands.ts",
		"config.ts",
		"mode.ts",
		"roles.ts",
		"runner.ts",
		"rpc-jsonl.ts",
		"run-store.ts",
		"types.ts",
		"version.ts",
    "handoff.ts",
		"roles/",
		"ui/",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"typecheck": "tsc -p tsconfig.json",
